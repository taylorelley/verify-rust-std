    pub const fn $METHOD<'a>(&'a self, current: $PUBLIC, new: $PUBLIC,
                             success: Ordering, failure: Ordering) -> Result<$PUBLIC, $PUBLIC>
    //@ req thread_token(currentThread) &*& [?q]lifetime_token('a) &*& [_](<$ATOMIC>.share('a, currentThread, self)) &*& <Ordering>.own(currentThread, success) &*& <Ordering>.own(currentThread, failure);
    //@ ens thread_token(currentThread) &*& [q]lifetime_token('a) &*& <std::result::Result<$PUBLIC, $PUBLIC>>.own(currentThread, result);
    //@ on_unwind_ens thread_token(currentThread) &*& [q]lifetime_token('a);
