    {
        open AlignedSlot_own(t, v);
        close AlignedSlot_own(t1, v);
    }
    @*/
}
#[repr(C)]
pub struct $ATOMIC {
    v: UnsafeCell<private::AlignedSlot>,
}
unsafe impl Send for $ATOMIC {}
unsafe impl Sync for $ATOMIC {}
impl $ATOMIC {
    pub const unsafe fn from_ptr<'a>(ptr: *mut $OPERAND) -> &'a $ATOMIC
    //@ req type_interp::<$ATOMIC>() &*& atomic_mask(MaskTop) &*& [?q]lifetime_token('a) &*& exists::<bool>(?fresh) &*& (if fresh { *ptr |-> ?value } else { [_](<$ATOMIC>.share)('a, currentThread, ptr as *$ATOMIC) }) &*& ptr as usize % std::mem::align_of::<$ATOMIC>() == 0;
    //@ ens type_interp::<$ATOMIC>() &*& atomic_mask(MaskTop) &*& [q]lifetime_token('a) &*& [_](<$ATOMIC>.share)('a, currentThread, result) &*& [_](<$ATOMIC>.share)('a, currentThread, ptr as *$ATOMIC) &*& [_]frac_borrow('a, ref_initialized_(result)) &*& ref_origin(result) == ref_origin(ptr as *$ATOMIC) &*& (if fresh { borrow_end_token('a, (<$ATOMIC>.full_borrow_content)(currentThread, ptr as *$ATOMIC)) } else { true });
    //@ on_unwind_ens false;
    {
        //@ open exists::<bool>(fresh);
        /*@ if fresh {
            close_points_to(ptr as *private::AlignedSlot);
            close_points_to(ptr as *$ATOMIC);
            assert *(ptr as *$ATOMIC) |-> ?atomic;
            close private::AlignedSlot_own(currentThread, atomic.v);
            close <$ATOMIC>.own(currentThread, atomic);
            close_full_borrow_content::<$ATOMIC>(currentThread, ptr as *$ATOMIC);
            borrow('a, (<$ATOMIC>.full_borrow_content)(currentThread, ptr as *$ATOMIC));
            share_full_borrow::<$ATOMIC>('a, currentThread, ptr as *$ATOMIC);
        } @*/
        //@ let p = precreate_ref(ptr as *$ATOMIC);
        //@ init_ref_share::<$ATOMIC>('a, currentThread, p);
        //@ open_frac_borrow('a, ref_initialized_(p), q);
        //@ open [?f]ref_initialized_::<$ATOMIC>(p)();
        let result = unsafe { &*ptr.cast() };
        //@ close [f]ref_initialized_::<$ATOMIC>(p)();
        //@ close_frac_borrow(f, ref_initialized_(p));
        result
    }
}
/*@
fix accepts_value(value: $OPERAND) -> bool { true }
pred_ctor own_atomic_contents(p: *$OPERAND)(;) = std::intrinsics::atomic_points_to(p, 1, accepts_value);
pred <$ATOMIC>.own(t, value) = <private::AlignedSlot>.own(t, value.v);
lem ${ATOMIC}_drop()
    req ${ATOMIC}_own(?t, ?a);
    ens <private::AlignedSlot>.own(t, a.v);
{
    open ${ATOMIC}_own(t, a);
}
lem ${ATOMIC}_send(t1: thread_id_t)
    req ${ATOMIC}_own(?t, ?a);
    ens ${ATOMIC}_own(t1, a);
{
    open ${ATOMIC}_own(t, a);
    private::AlignedSlot_send(t1);
    close ${ATOMIC}_own(t1, a);
}
pred <$ATOMIC>.share(k, t, l) = [_]frac_borrow(k, own_atomic_contents(ref_origin(l) as *$OPERAND));

lem ${ATOMIC}_share_mono(k: lifetime_t, k1: lifetime_t, t: thread_id_t, l: *$ATOMIC)
    req lifetime_inclusion(k1, k) == true &*& [_]${ATOMIC}_share(k, t, l);
    ens [_]${ATOMIC}_share(k1, t, l);
{
    open ${ATOMIC}_share(k, t, l);
    frac_borrow_mono(k, k1, own_atomic_contents(ref_origin(l) as *$OPERAND));
    close ${ATOMIC}_share(k1, t, l);
    leak ${ATOMIC}_share(k1, t, l);
}

lem ${ATOMIC}_sync(t1: thread_id_t)
    req is_Sync(typeid($ATOMIC)) == true &*& [_]${ATOMIC}_share(?k, ?t0, ?l);
    ens [_]${ATOMIC}_share(k, t1, l);
{
    open ${ATOMIC}_share(k, t0, l);
    close ${ATOMIC}_share(k, t1, l);
    leak ${ATOMIC}_share(k, t1, l);
}

lem ${ATOMIC}_share_full(k: lifetime_t, t: thread_id_t, l: *$ATOMIC)
    req atomic_mask(MaskTop) &*& full_borrow(k, ${ATOMIC}_full_borrow_content(t, l)) &*& [?q]lifetime_token(k) &*& ref_origin(l) == l;
    ens atomic_mask(MaskTop) &*& [_]${ATOMIC}_share(k, t, l) &*& [q]lifetime_token(k);
{
    open_full_borrow_strong_m_(k, ${ATOMIC}_full_borrow_content(t, l));
    open ${ATOMIC}_full_borrow_content(t, l)();
    assert ${ATOMIC}_own(t, ?stored);
    open ${ATOMIC}_own(t, stored);
    open private::AlignedSlot_own(t, stored.v);
    open_points_to(l as *private::AlignedSlot);
    close_points_to(l as *private::AlignedSlot);
    to_u8s_(l as *private::AlignedSlot);
    from_u8s_(l as *private::AlignedSlot);
    open_points_to(l as *private::AlignedSlot);
    std::intrinsics::$ALIGN_LEMMA;
    assert l as usize % std::mem::align_of::<private::AlignedSlot>() == 0;
    assert std::mem::align_of::<private::AlignedSlot>() == $WIDTH;
    std::intrinsics::close_atomic_points_to_m(l as *$OPERAND, accepts_value);
    close own_atomic_contents(l as *$OPERAND)();
    close True();
    produce_lem_ptr_chunk restore_full_borrow_(True, own_atomic_contents(l as *$OPERAND), ${ATOMIC}_full_borrow_content(t, l))() {
        open True();
        open own_atomic_contents(l as *$OPERAND)();
        std::intrinsics::open_atomic_points_to(l as *$OPERAND);
        close_points_to(l as *private::AlignedSlot);
        close_points_to(l);
        assert *l |-> ?value;
        close private::AlignedSlot_own(t, value.v);
        close ${ATOMIC}_own(t, value);
        open_points_to(l);
        close ${ATOMIC}_full_borrow_content(t, l)();
    } {
        close_full_borrow_strong_m_();
    }
    full_borrow_into_frac_m(k, own_atomic_contents(l as *$OPERAND));
    close ${ATOMIC}_share(k, t, l);
    leak ${ATOMIC}_share(k, t, l);
}

lem init_ref_$ATOMIC(p: *$ATOMIC)
    req atomic_mask(Nlft) &*& ref_init_perm(p, ?x) &*& [_]${ATOMIC}_share(?k, ?t, x) &*& [?q]lifetime_token(k);
    ens atomic_mask(Nlft) &*& [q]lifetime_token(k) &*& [_]${ATOMIC}_share(k, t, p) &*& [_]frac_borrow(k, ref_initialized_(p));
{
    open ${ATOMIC}_share(k, t, x);
    open_ref_init_perm_$ATOMIC(p);
    close_ref_initialized_$ATOMIC(p, 1);
    close ref_initialized_::<$ATOMIC>(p)();
    borrow_m(k, ref_initialized_(p));
    leak borrow_end_token(k, ref_initialized_(p));
    full_borrow_into_frac_m(k, ref_initialized_(p));
    close ${ATOMIC}_share(k, t, p);
    leak ${ATOMIC}_share(k, t, p);
}
@*/
// Included in the proof suite to check that the sharing contract is usable.
unsafe fn share_twice<'a>(ptr: *mut $OPERAND) -> (&'a $ATOMIC, &'a $ATOMIC)
//@ req type_interp::<$ATOMIC>() &*& atomic_mask(MaskTop) &*& [?q]lifetime_token('a) &*& *ptr |-> ?value &*& ptr as usize % std::mem::align_of::<$ATOMIC>() == 0;
//@ ens type_interp::<$ATOMIC>() &*& atomic_mask(MaskTop) &*& [q]lifetime_token('a) &*& [_]${ATOMIC}_share('a, currentThread, result.0) &*& [_]${ATOMIC}_share('a, currentThread, result.1) &*& borrow_end_token('a, ${ATOMIC}_full_borrow_content(currentThread, ptr as *$ATOMIC));
//@ on_unwind_ens false;
{
    //@ close exists::<bool>(true);
    let first = unsafe { $ATOMIC::from_ptr/*@::<'a>@*/(ptr) };
    //@ close exists::<bool>(false);
    let second = unsafe { $ATOMIC::from_ptr/*@::<'a>@*/(ptr) };
    (first, second)
}

// End the modeled scope before recovering ownership of the pointer slot.
unsafe fn recover_slot(slot: *mut $OPERAND)
//@ req type_interp::<$ATOMIC>() &*& atomic_mask(MaskTop) &*& *slot |-> ?initial &*& slot as usize % std::mem::align_of::<$ATOMIC>() == 0;
//@ ens type_interp::<$ATOMIC>() &*& atomic_mask(MaskTop) &*& *slot |-> _;
//@ on_unwind_ens false;
{
    //@ let k = begin_lifetime_m();
    {
        //@ let_lft 'scope = k;
        let _refs = unsafe { share_twice/*@::<'scope>@*/(slot) };
    }
    //@ end_lifetime_m(k);
    //@ let cell = slot as *$ATOMIC;
    //@ borrow_end_m(k, ${ATOMIC}_full_borrow_content(currentThread, cell));
    //@ open ${ATOMIC}_full_borrow_content(currentThread, cell)();
    //@ assert ${ATOMIC}_own(currentThread, ?stored);
    //@ open ${ATOMIC}_own(currentThread, stored);
    //@ open private::AlignedSlot_own(currentThread, stored.v);
    //@ open_points_to(cell as *private::AlignedSlot);
}
