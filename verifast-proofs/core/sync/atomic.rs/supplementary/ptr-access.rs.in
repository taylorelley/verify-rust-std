#![feature(core_intrinsics)]
#![allow(internal_features)]

use std::intrinsics::{self, AtomicOrdering as AO};
use Ordering::*;

#[derive(Copy, Clone)]
#[non_exhaustive]
pub enum Ordering {
    Relaxed,
    Release,
    Acquire,
    AcqRel,
    SeqCst,
}

// METHODS
    pub const fn load<'a>(&'a self, order: Ordering) -> *mut Pointee
    //@ req thread_token(currentThread) &*& [?q]lifetime_token('a) &*& [_](<AtomicPtr>.share('a, currentThread, self)) &*& <Ordering>.own(currentThread, order);
    //@ ens thread_token(currentThread) &*& [q]lifetime_token('a);
    //@ on_unwind_ens thread_token(currentThread) &*& [q]lifetime_token('a);
    {
        unsafe {
            //@ leak <Ordering>.own(_, _);
            //@ close exists::<*AtomicPtr>(self);
            //@ close exists::<lifetime_t>('a);
            atomic_load(self.v.get().cast::<*mut Pointee>(), order)
        }
    }

    pub const fn store<'a>(&'a self, val: *mut Pointee, order: Ordering)
    //@ req thread_token(currentThread) &*& [?q]lifetime_token('a) &*& [_](<AtomicPtr>.share('a, currentThread, self)) &*& <Ordering>.own(currentThread, order);
    //@ ens thread_token(currentThread) &*& [q]lifetime_token('a);
    //@ on_unwind_ens thread_token(currentThread) &*& [q]lifetime_token('a);
    {
        unsafe {
            //@ leak <Ordering>.own(_, _);
            //@ close exists::<*AtomicPtr>(self);
            //@ close exists::<lifetime_t>('a);
            atomic_store(self.v.get().cast::<*mut Pointee>(), val, order);
        }
    }

    pub const fn as_ptr<'a>(&'a self) -> *mut *mut Pointee
    //@ req [?q]lifetime_token('a) &*& [_](<AtomicPtr>.share('a, currentThread, self));
    //@ ens [q]lifetime_token('a) &*& result == ref_origin(self) as **mut Pointee;
    //@ on_unwind_ens false;
    {
        self.v.get().cast()
    }
// HELPERS
// Open the borrow only in branches that reach a non-unwinding intrinsic.
// On invalid orderings the caller's lifetime and thread tokens reach the
// panic unchanged.
const unsafe fn atomic_store(dst: *mut *mut Pointee, val: *mut Pointee, order: Ordering)
//@ req thread_token(currentThread) &*& exists::<*AtomicPtr>(?atomic) &*& exists::<lifetime_t>(?k) &*& [?q]lifetime_token(k) &*& [_]AtomicPtr_share(k, currentThread, atomic) &*& dst == ref_origin(atomic) as **mut Pointee &*& accepts_value(val) == true;
//@ ens thread_token(currentThread) &*& [q]lifetime_token(k);
//@ on_unwind_ens thread_token(currentThread) &*& [q]lifetime_token(k);
{
    //@ open exists::<*AtomicPtr>(atomic);
    //@ open exists::<lifetime_t>(k);
    // SAFETY: the caller must uphold the safety contract for `atomic_store`.
    unsafe {
        match order {
            Relaxed => {
                //@ open AtomicPtr_share(k, currentThread, atomic);
                //@ open_frac_borrow(k, own_atomic_contents(dst), q);
                //@ open [?f]own_atomic_contents(dst)();
                intrinsics::atomic_store::<*mut Pointee, { AO::Relaxed }, false>(dst, val);
                //@ close [f]own_atomic_contents(dst)();
                //@ close_frac_borrow(f, own_atomic_contents(dst));
            }
            Release => {
                //@ open AtomicPtr_share(k, currentThread, atomic);
                //@ open_frac_borrow(k, own_atomic_contents(dst), q);
                //@ open [?f]own_atomic_contents(dst)();
                intrinsics::atomic_store::<*mut Pointee, { AO::Release }, false>(dst, val);
                //@ close [f]own_atomic_contents(dst)();
                //@ close_frac_borrow(f, own_atomic_contents(dst));
            }
            SeqCst => {
                //@ open AtomicPtr_share(k, currentThread, atomic);
                //@ open_frac_borrow(k, own_atomic_contents(dst), q);
                //@ open [?f]own_atomic_contents(dst)();
                intrinsics::atomic_store::<*mut Pointee, { AO::SeqCst }, false>(dst, val);
                //@ close [f]own_atomic_contents(dst)();
                //@ close_frac_borrow(f, own_atomic_contents(dst));
            }
            Acquire => panic!("there is no such thing as an acquire store"),
            AcqRel => panic!("there is no such thing as an acquire-release store"),
        }
    }
}

// Keep the lifetime token available on any branch that can unwind.
const unsafe fn atomic_load(src: *const *mut Pointee, order: Ordering) -> *mut Pointee
//@ req thread_token(currentThread) &*& exists::<*AtomicPtr>(?atomic) &*& exists::<lifetime_t>(?k) &*& [?q]lifetime_token(k) &*& [_]AtomicPtr_share(k, currentThread, atomic) &*& src == ref_origin(atomic) as *const *mut Pointee;
//@ ens thread_token(currentThread) &*& [q]lifetime_token(k) &*& accepts_value(result) == true;
//@ on_unwind_ens thread_token(currentThread) &*& [q]lifetime_token(k);
{
    //@ open exists::<*AtomicPtr>(atomic);
    //@ open exists::<lifetime_t>(k);
    unsafe {
        match order {
            Relaxed => {
                //@ open AtomicPtr_share(k, currentThread, atomic);
                //@ open_frac_borrow(k, own_atomic_contents(src as **mut Pointee), q);
                //@ open [?f]own_atomic_contents(src as **mut Pointee)();
                let value = intrinsics::atomic_load::<*mut Pointee, { AO::Relaxed }, false>(src);
                //@ close [f]own_atomic_contents(src as **mut Pointee)();
                //@ close_frac_borrow(f, own_atomic_contents(src as **mut Pointee));
                value
            }
            Acquire => {
                //@ open AtomicPtr_share(k, currentThread, atomic);
                //@ open_frac_borrow(k, own_atomic_contents(src as **mut Pointee), q);
                //@ open [?f]own_atomic_contents(src as **mut Pointee)();
                let value = intrinsics::atomic_load::<*mut Pointee, { AO::Acquire }, false>(src);
                //@ close [f]own_atomic_contents(src as **mut Pointee)();
                //@ close_frac_borrow(f, own_atomic_contents(src as **mut Pointee));
                value
            }
            SeqCst => {
                //@ open AtomicPtr_share(k, currentThread, atomic);
                //@ open_frac_borrow(k, own_atomic_contents(src as **mut Pointee), q);
                //@ open [?f]own_atomic_contents(src as **mut Pointee)();
                let value = intrinsics::atomic_load::<*mut Pointee, { AO::SeqCst }, false>(src);
                //@ close [f]own_atomic_contents(src as **mut Pointee)();
                //@ close_frac_borrow(f, own_atomic_contents(src as **mut Pointee));
                value
            }
            Release => panic!("there is no such thing as a release load"),
            AcqRel => panic!("there is no such thing as an acquire-release load"),
        }
    }
}

// A load needs only a read fraction. The rejection control substitutes a
// store here and must fail for lack of the full underlying slot permission.
unsafe fn read_pointer_fraction(src: *mut *mut Pointee) -> *mut Pointee
//@ req std::intrinsics::atomic_points_to(src, 1/2, accepts_value);
//@ ens std::intrinsics::atomic_points_to(src, 1/2, accepts_value);
//@ on_unwind_ens false;
{
    unsafe { intrinsics::atomic_load::<*mut Pointee, { AO::Relaxed }, false>(src as *const *mut Pointee) }
}
