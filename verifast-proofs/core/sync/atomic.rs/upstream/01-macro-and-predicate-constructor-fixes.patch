diff --git a/tests/rust/macro_fn_specs.rs b/tests/rust/macro_fn_specs.rs
new file mode 100644
index 0000000..dbda5cb
--- /dev/null
+++ b/tests/rust/macro_fn_specs.rs
@@ -0,0 +1,17 @@
+// Annotations written in a macro body apply to every expansion of the macro.
+macro_rules! constant_fn {
+    ($name:ident, $value:expr) => {
+        pub fn $name() -> i32
+        //@ req true;
+        //@ ens result == 1; //~should_fail
+        {
+            $value
+        }
+    };
+}
+
+constant_fn!(one, 1);
+// Without a shared contract, the second expansion would be skipped as specless.
+constant_fn!(two, 2);
+
+fn main() {}
diff --git a/tests/rust/pred_ctor_generic_args.rs b/tests/rust/pred_ctor_generic_args.rs
new file mode 100644
index 0000000..9bf4b33
--- /dev/null
+++ b/tests/rust/pred_ctor_generic_args.rs
@@ -0,0 +1,34 @@
+// A generic predicate constructor applied in a generic lemma's contract. Its
+// arguments must be checked against its instantiated parameter types.
+struct Wrap<T> {
+    x: T,
+}
+
+/*@
+
+pred_ctor holds<T>(p: *T)(;) = *p |-> ?v;
+
+lem wrap_holds<V>(p: *Wrap<V>)
+    req [?f]holds::<Wrap<V> >(p)();
+    ens [f](*p |-> ?v);
+{
+    open [f]holds::<Wrap<V> >(p)();
+}
+
+lem wrap_holds_inferred<V>(p: *Wrap<V>)
+    req [?f]holds(p)();
+    ens [f](*p |-> ?v);
+{
+    open [f]holds::<Wrap<V> >(p)();
+}
+
+lem wrap_holds_bad<V>(p: *Wrap<V>, q: *V)
+    req [?f]holds::<Wrap<V> >(q)(); //~should_fail
+    ens true;
+{
+    assume(false);
+}
+
+@*/
+
+fn main() {}
diff --git a/tests/rust/pred_ctor_infer_targs.rs b/tests/rust/pred_ctor_infer_targs.rs
new file mode 100644
index 0000000..558618a
--- /dev/null
+++ b/tests/rust/pred_ctor_infer_targs.rs
@@ -0,0 +1,27 @@
+// The type arguments of a generic predicate constructor are inferred from its
+// arguments in open and close statements.
+/*@
+
+pred_ctor holds<T>(p: *T)() = *p |-> ?v;
+
+pred_ctor holds_any<T>(n: i32)() = true;
+
+lem roundtrip(p: *u16)
+    req *p |-> ?v;
+    ens *p |-> _;
+{
+    close holds(p)();
+    open holds(p)();
+}
+
+lem not_inferable()
+    req true;
+    ens true;
+{
+    close holds_any(0)(); //~should_fail
+    leak holds_any::<u8>(0)();
+}
+
+@*/
+
+fn main() {}
