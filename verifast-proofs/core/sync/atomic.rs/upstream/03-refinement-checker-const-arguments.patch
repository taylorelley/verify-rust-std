diff --git a/tests/rust/refinement_checker/const_args_orig.rs b/tests/rust/refinement_checker/const_args_orig.rs
new file mode 100644
index 0000000..7f99003
--- /dev/null
+++ b/tests/rust/refinement_checker/const_args_orig.rs
@@ -0,0 +1,9 @@
+#![feature(core_intrinsics)]
+#![allow(internal_features)]
+use std::intrinsics::{self, AtomicOrdering as AO};
+
+pub unsafe fn load<T: Copy, const VOLATILE: bool>(p: *const T) -> T {
+    unsafe { intrinsics::atomic_load::<T, { AO::Acquire }, VOLATILE>(p) }
+}
+
+fn main() {}
