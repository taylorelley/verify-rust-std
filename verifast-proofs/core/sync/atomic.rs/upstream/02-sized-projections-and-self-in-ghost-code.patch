diff --git a/tests/rust/assoc_type_projection.rs b/tests/rust/assoc_type_projection.rs
new file mode 100644
index 0000000..0d79f19
--- /dev/null
+++ b/tests/rust/assoc_type_projection.rs
@@ -0,0 +1,30 @@
+// A struct whose field type is a projection of an associated type with an
+// explicit or implicit Sized bound.
+use std::cell::UnsafeCell;
+
+pub trait Primitive {
+    type Storage;
+}
+
+pub trait ExplicitlySized {
+    type Storage: Sized;
+}
+
+impl Primitive for u8 {
+    type Storage = u8;
+}
+
+#[repr(C)]
+pub struct Cell<T: Primitive> {
+    v: UnsafeCell<T::Storage>,
+}
+
+#[repr(C)]
+pub struct Cell2<T: ExplicitlySized> {
+    v: T::Storage,
+}
+
+pub fn smoke()
+//@ req true;
+//@ ens true;
+{}
diff --git a/tests/rust/self_in_ghost.rs b/tests/rust/self_in_ghost.rs
new file mode 100644
index 0000000..2c50299
--- /dev/null
+++ b/tests/rust/self_in_ghost.rs
@@ -0,0 +1,50 @@
+// Ghost code in an inherent impl can refer to the impl's self type as Self.
+pub struct Wrap<T> {
+    x: T,
+}
+
+impl Wrap<u16> {
+    pub fn size() -> usize
+    //@ req true;
+    //@ ens result == std::mem::size_of::<Self>();
+    {
+        std::mem::size_of::<Wrap<u16>>()
+    }
+}
+
+impl<T> Wrap<T> {
+    pub fn identity(p: *mut Wrap<T>) -> *mut Wrap<T>
+    //@ req true;
+    //@ ens result == p as *Self;
+    {
+        p
+    }
+}
+
+// In a macro, Self is the only way for ghost code to name each expansion's type.
+macro_rules! sized {
+    ($t:ty) => {
+        impl Wrap<$t> {
+            pub fn size_of_self() -> usize
+            //@ req true;
+            //@ ens result == std::mem::size_of::<Self>();
+            {
+                std::mem::size_of::<Wrap<$t>>()
+            }
+        }
+    };
+}
+
+sized!(u8);
+sized!(u64);
+
+impl Wrap<u32> {
+    pub fn wrong_size() -> usize
+    //@ req true;
+    //@ ens result == std::mem::size_of::<Self>(); //~should_fail
+    {
+        std::mem::size_of::<Wrap<u8>>()
+    }
+}
+
+fn main() {}
