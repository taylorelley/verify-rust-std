// Permission proof adapted from model-checking/verify-rust-std PR #675.
use std::cell::UnsafeCell;

// Each replay substitutes one of the five required pointee sizes.
pub struct Pointee([u8; $SIZE]);
mod private {
    #[repr(C, align(8))]
    pub struct Align8(*mut super::Pointee);
    /*@
    pred <Align8>.own(t, v) = true;
    lem Align8_drop()
        req Align8_own(?t, ?v);
        ens true;
    {
        open Align8_own(t, v);
    }
    lem Align8_send(t1: thread_id_t)
        req Align8_own(?t, ?v);
        ens Align8_own(t1, v);
    {
        open Align8_own(t, v);
        close Align8_own(t1, v);
    }
    @*/
}
#[repr(C)]
pub struct AtomicPtr {
    v: UnsafeCell<private::Align8>,
}
unsafe impl Send for AtomicPtr {}
unsafe impl Sync for AtomicPtr {}
impl AtomicPtr {
    pub const unsafe fn from_ptr<'a>(ptr: *mut *mut Pointee) -> &'a AtomicPtr
    //@ req type_interp::<AtomicPtr>() &*& atomic_mask(MaskTop) &*& [?q]lifetime_token('a) &*& exists::<bool>(?fresh) &*& (if fresh { *ptr |-> ?value } else { [_](<AtomicPtr>.share)('a, currentThread, ptr as *AtomicPtr) }) &*& ptr as usize % std::mem::align_of::<AtomicPtr>() == 0;
    //@ ens type_interp::<AtomicPtr>() &*& atomic_mask(MaskTop) &*& [q]lifetime_token('a) &*& [_](<AtomicPtr>.share)('a, currentThread, result) &*& [_](<AtomicPtr>.share)('a, currentThread, ptr as *AtomicPtr) &*& [_]frac_borrow('a, ref_initialized_(result)) &*& ref_origin(result) == ref_origin(ptr as *AtomicPtr) &*& (if fresh { borrow_end_token('a, (<AtomicPtr>.full_borrow_content)(currentThread, ptr as *AtomicPtr)) } else { true });
    //@ on_unwind_ens false;
    {
        //@ open exists::<bool>(fresh);
        /*@ if fresh {
            close_points_to(ptr as *private::Align8);
            close_points_to(ptr as *AtomicPtr);
            assert *(ptr as *AtomicPtr) |-> ?atomic;
            close private::Align8_own(currentThread, atomic.v);
            close <AtomicPtr>.own(currentThread, atomic);
            close_full_borrow_content::<AtomicPtr>(currentThread, ptr as *AtomicPtr);
            borrow('a, (<AtomicPtr>.full_borrow_content)(currentThread, ptr as *AtomicPtr));
            share_full_borrow::<AtomicPtr>('a, currentThread, ptr as *AtomicPtr);
        } @*/
        //@ let p = precreate_ref(ptr as *AtomicPtr);
        //@ init_ref_share::<AtomicPtr>('a, currentThread, p);
        //@ open_frac_borrow('a, ref_initialized_(p), q);
        //@ open [?f]ref_initialized_::<AtomicPtr>(p)();
        let result = unsafe { &*ptr.cast() };
        //@ close [f]ref_initialized_::<AtomicPtr>(p)();
        //@ close_frac_borrow(f, ref_initialized_(p));
        result
    }
}
/*@
fix accepts_ptr(value: *Pointee) -> bool { true }
pred_ctor own_atomic_contents(p: **Pointee)(;) = std::intrinsics::atomic_points_to(p, 1, accepts_ptr);
pred <AtomicPtr>.own(t, value) = <private::Align8>.own(t, value.v);
lem AtomicPtr_drop()
    req AtomicPtr_own(?t, ?a);
    ens <private::Align8>.own(t, a.v);
{
    open AtomicPtr_own(t, a);
}
lem AtomicPtr_send(t1: thread_id_t)
    req AtomicPtr_own(?t, ?a);
    ens AtomicPtr_own(t1, a);
{
    open AtomicPtr_own(t, a);
    private::Align8_send(t1);
    close AtomicPtr_own(t1, a);
}
pred <AtomicPtr>.share(k, t, l) = [_]frac_borrow(k, own_atomic_contents(ref_origin(l) as **Pointee));

lem AtomicPtr_share_mono(k: lifetime_t, k1: lifetime_t, t: thread_id_t, l: *AtomicPtr)
    req lifetime_inclusion(k1, k) == true &*& [_]AtomicPtr_share(k, t, l);
    ens [_]AtomicPtr_share(k1, t, l);
{
    open AtomicPtr_share(k, t, l);
    frac_borrow_mono(k, k1, own_atomic_contents(ref_origin(l) as **Pointee));
    close AtomicPtr_share(k1, t, l);
    leak AtomicPtr_share(k1, t, l);
}

lem AtomicPtr_sync(t1: thread_id_t)
    req is_Sync(typeid(AtomicPtr)) == true &*& [_]AtomicPtr_share(?k, ?t0, ?l);
    ens [_]AtomicPtr_share(k, t1, l);
{
    open AtomicPtr_share(k, t0, l);
    close AtomicPtr_share(k, t1, l);
    leak AtomicPtr_share(k, t1, l);
}

lem AtomicPtr_share_full(k: lifetime_t, t: thread_id_t, l: *AtomicPtr)
    req atomic_mask(MaskTop) &*& full_borrow(k, AtomicPtr_full_borrow_content(t, l)) &*& [?q]lifetime_token(k) &*& ref_origin(l) == l;
    ens atomic_mask(MaskTop) &*& [_]AtomicPtr_share(k, t, l) &*& [q]lifetime_token(k);
