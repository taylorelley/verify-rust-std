    std::intrinsics::atomic_align_of_ptr::<Pointee>();
    assert l as usize % std::mem::align_of::<private::Align8>() == 0;
    assert std::mem::align_of::<private::Align8>() == 8;
    std::intrinsics::close_atomic_points_to_m(l as **Pointee, accepts_ptr);
    close own_atomic_contents(l as **Pointee)();
    close True();
    produce_lem_ptr_chunk restore_full_borrow_(True, own_atomic_contents(l as **Pointee), AtomicPtr_full_borrow_content(t, l))() {
        open True();
