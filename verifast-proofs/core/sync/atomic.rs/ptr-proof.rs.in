        close_full_borrow_strong_m_();
    }
    full_borrow_into_frac_m(k, own_atomic_contents(l as **Pointee));
    close AtomicPtr_share(k, t, l);
    leak AtomicPtr_share(k, t, l);
}

lem init_ref_AtomicPtr(p: *AtomicPtr)
    req atomic_mask(Nlft) &*& ref_init_perm(p, ?x) &*& [_]AtomicPtr_share(?k, ?t, x) &*& [?q]lifetime_token(k);
    ens atomic_mask(Nlft) &*& [q]lifetime_token(k) &*& [_]AtomicPtr_share(k, t, p) &*& [_]frac_borrow(k, ref_initialized_(p));
{
    open AtomicPtr_share(k, t, x);
    open_ref_init_perm_AtomicPtr(p);
    close_ref_initialized_AtomicPtr(p, 1);
    close ref_initialized_::<AtomicPtr>(p)();
    borrow_m(k, ref_initialized_(p));
    leak borrow_end_token(k, ref_initialized_(p));
    full_borrow_into_frac_m(k, ref_initialized_(p));
    close AtomicPtr_share(k, t, p);
    leak AtomicPtr_share(k, t, p);
}
@*/
// Included in the proof suite to check that the sharing contract is usable.
unsafe fn share_twice<'a>(ptr: *mut *mut Pointee) -> (&'a AtomicPtr, &'a AtomicPtr)
//@ req type_interp::<AtomicPtr>() &*& atomic_mask(MaskTop) &*& [?q]lifetime_token('a) &*& *ptr |-> ?value &*& ptr as usize % std::mem::align_of::<AtomicPtr>() == 0;
//@ ens type_interp::<AtomicPtr>() &*& atomic_mask(MaskTop) &*& [q]lifetime_token('a) &*& [_]AtomicPtr_share('a, currentThread, result.0) &*& [_]AtomicPtr_share('a, currentThread, result.1) &*& borrow_end_token('a, AtomicPtr_full_borrow_content(currentThread, ptr as *AtomicPtr));
//@ on_unwind_ens false;
{
    //@ close exists::<bool>(true);
    let first = unsafe { AtomicPtr::from_ptr/*@::<'a>@*/(ptr) };
    //@ close exists::<bool>(false);
    let second = unsafe { AtomicPtr::from_ptr/*@::<'a>@*/(ptr) };
    (first, second)
}

// End the modeled scope before recovering ownership of the pointer slot.
unsafe fn recover_slot(slot: *mut *mut Pointee)
//@ req type_interp::<AtomicPtr>() &*& atomic_mask(MaskTop) &*& *slot |-> ?initial &*& slot as usize % std::mem::align_of::<AtomicPtr>() == 0;
//@ ens type_interp::<AtomicPtr>() &*& atomic_mask(MaskTop) &*& *slot |-> _;
//@ on_unwind_ens false;
{
    //@ let k = begin_lifetime_m();
    {
        //@ let_lft 'scope = k;
        let _refs = unsafe { share_twice/*@::<'scope>@*/(slot) };
    }
    //@ end_lifetime_m(k);
    //@ let cell = slot as *AtomicPtr;
    //@ borrow_end_m(k, AtomicPtr_full_borrow_content(currentThread, cell));
    //@ open AtomicPtr_full_borrow_content(currentThread, cell)();
    //@ assert AtomicPtr_own(currentThread, ?stored);
    //@ open AtomicPtr_own(currentThread, stored);
    //@ open private::Align8_own(currentThread, stored.v);
    //@ open_points_to(cell as *private::Align8);
}
