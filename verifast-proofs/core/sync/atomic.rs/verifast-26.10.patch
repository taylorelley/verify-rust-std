diff --git a/tests/rust/macro_fn_specs.rs b/tests/rust/macro_fn_specs.rs
new file mode 100644
index 0000000..dbda5cb
--- /dev/null
+++ b/tests/rust/macro_fn_specs.rs
@@ -0,0 +1,17 @@
+// Annotations written in a macro body apply to every expansion of the macro.
+macro_rules! constant_fn {
+    ($name:ident, $value:expr) => {
+        pub fn $name() -> i32
+        //@ req true;
+        //@ ens result == 1; //~should_fail
+        {
+            $value
+        }
+    };
+}
+
+constant_fn!(one, 1);
+// Without a shared contract, the second expansion would be skipped as specless.
+constant_fn!(two, 2);
+
+fn main() {}
