+++ b/tests/rust/assoc_type_projection.rs
@@ -0,0 +1,36 @@
+// A struct whose field type is a projection of an associated type with an
+// explicit or implicit Sized bound.
+use std::cell::UnsafeCell;
+
+pub trait Primitive {
+    type Storage;
+}
+
+pub trait ExplicitlySized {
+    type Storage: Sized;
+}
+
+impl Primitive for u8 {
+    type Storage = u8;
+}
+
+#[repr(C)]
+pub struct Cell<T: Primitive> {
+    v: UnsafeCell<T::Storage>,
+}
+
+#[repr(C)]
+pub struct Cell2<T: ExplicitlySized> {
+    v: T::Storage,
+}
+
+// A projection of an associated type of a trait declared in an .rsspec file.
+pub struct Peeked<I: Iterator> {
+    item: Option<I::Item>,
+    iter: I,
+}
+
+pub fn smoke()
+//@ req true;
+//@ ens true;
+{}
diff --git a/tests/rust/instance_alignment.rs b/tests/rust/instance_alignment.rs
new file mode 100644
index 0000000..66231c9
--- /dev/null
+++ b/tests/rust/instance_alignment.rs
@@ -0,0 +1,59 @@
+// Rustc's alignment for instances of a generic struct that appear in local
+// function signatures.
+#[repr(C, align(2))]
+pub struct Align2<T>(T);
+
+#[repr(C)]
+pub struct Wrap<T> {
+    x: T,
+}
+
+pub fn concrete(_p: *mut Align2<u8>, _q: *mut Wrap<u64>)
+//@ req true;
+//@ ens true;
+{
+    //@ assert std::mem::align_of::<Align2<u8> >() == 2;
+    //@ assert std::mem::align_of::<Wrap<u64> >() == 8;
+}
+
+// The layout of Wrap<*mut T> does not depend on T: Sized.
+pub fn generic<T>(_p: *mut Wrap<*mut T>)
+//@ req true;
+//@ ens true;
+{
+    //@ assert std::mem::align_of::<Wrap<*mut T> >() == std::mem::size_of::<usize>();
+}
+
+pub fn not_exported(_p: *mut Wrap<u32>)
+//@ req true;
+//@ ens true;
+{
+    //@ assert std::mem::align_of::<Wrap<u16> >() == 2; //~should_fail
+}
+
+// A bound on an associated type can fix the layout of an instance in one
+// function. The fact must not be generalized to every type argument.
+pub trait Primitive {
+    type Storage;
+}
+
+#[repr(C)]
+pub struct Cell<T: Primitive> {
+    v: T::Storage,
+}
+
+pub fn narrowed<T: Primitive<Storage = u8>>(_p: *mut Cell<T>)
+//@ req true;
+//@ ens true;
+{
+    //@ assert std::mem::align_of::<Cell<T> >() == 1; //~should_fail
+}
+
+pub fn widened<T: Primitive<Storage = u64>>(_p: *mut Cell<T>)
+//@ req true;
+//@ ens true;
+{
+    //@ assert std::mem::align_of::<Cell<T> >() == 8; //~should_fail
+}
+
+fn main() {}
