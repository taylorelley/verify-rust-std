+  (* Select the existing primitive contract for the compiler's concrete
+     ordinary u8 stores. Other widths and volatile stores need their own
+     review and are deliberately rejected by this narrow proof frontend. *)
+  and specialize_u8_atomic_store (fn_ty : D.ty_kind_fn_def_ty) loc =
+    match fn_ty.id.name with
+    | "core::intrinsics::atomic_store" | "std::intrinsics::atomic_store" ->
+        let reject reason = Ast.static_error loc ("atomic_store: " ^ reason) None in
+        (match fn_ty.substs with
+        | [
+            ({kind = Type {kind = UInt U8}} as operand);
+            {kind = Const {kind = Value {
+               ty = {kind = Adt {
+                 id = {name = ("core::intrinsics::AtomicOrdering" |
+                               "std::intrinsics::AtomicOrdering")};
+                 kind = EnumKind; substs = [];
+               }};
+               val_tree = Branch [{kind = Value {ty = {kind = UInt U32};
+                 val_tree = Leaf {data = order; size = 4}}}];
+             }}};
+            {kind = Const {kind = Value {
+               ty = {kind = Bool};
+               val_tree = Leaf {data = volatile; size = 1};
+             }}};
+          ] when fn_ty.late_bound_generic_param_count = 0 ->
+            if Stdint.Uint128.to_string (DecoderAux.uint128_get volatile) <> "0" then
+              reject "only ordinary stores (VOLATILE=false) are modeled";
+            let suffix =
+              match Stdint.Uint128.to_string (DecoderAux.uint128_get order) with
+              | "0" -> "relaxed"
+              | "1" -> "release"
+              | "4" -> "seqcst"
+              | _ -> reject "unsupported ordering for an ordinary store"
+            in
+            Some ("std::intrinsics::atomic_store_" ^ suffix, [operand])
+        | _ -> reject "expected u8, a concrete AtomicOrdering, and VOLATILE=false")
+    | _ -> None
+
